<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="700.0" spacing="15.0" stylesheets="@../resources/styles/DashboardStyle.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.quickmartkinal.system.controller.DashboardController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label styleClass="titulo" text="QuickMart" />
      <Label fx:id="lblBienvenida" styleClass="etiqueta" text="Bienvenido" />
      <Label fx:id="lblRol" styleClass="etiqueta" text="Rol" />
      <Label styleClass="subtitulo" text="(Aqui se conectara el modulo de catalogo en el siguiente sprint)" wrapText="true" />
      <Button mnemonicParsing="false" onMouseClicked="#onLogout" styleClass="btn-login" text="Cerrar sesion" />
   </children>
</VBox>
