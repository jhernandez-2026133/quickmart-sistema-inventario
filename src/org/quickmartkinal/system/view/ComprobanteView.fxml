<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<VBox fx:id="panelComprobante" spacing="12.0" styleClass="root" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.quickmartkinal.system.controller.ComprobanteController">
   <stylesheets>
      <URL value="@../resources/styles/CatalogoStyles.css" />
   </stylesheets>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label styleClass="titulo" text="QuickMart - Comprobante de Venta" />
      <Label fx:id="lblIdVenta" styleClass="etiqueta" text="Venta" />
      <Label fx:id="lblFecha" styleClass="etiqueta" text="Fecha" />
      <Label fx:id="lblCliente" styleClass="etiqueta" text="Cliente" />

      <TableView fx:id="tblComprobante" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colProducto" text="Producto" prefWidth="140.0" />
            <TableColumn fx:id="colCategoria" text="Categoria" prefWidth="110.0" />
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80.0" />
            <TableColumn fx:id="colPrecioUnitario" text="Precio Unitario" prefWidth="110.0" />
            <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="100.0" />
         </columns>
      </TableView>

      <Label fx:id="lblTotal" styleClass="titulo" text="Total: Q0.00" />

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="btnCerrar" mnemonicParsing="false" onMouseClicked="#onCerrar" styleClass="btn-primary" text="Cerrar" />
         </children>
      </HBox>
   </children>
</VBox>
