<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<VBox fx:id="panelInventarioVentas" spacing="12.0" styleClass="root" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.quickmartkinal.system.controller.InventarioVentasController">
   <stylesheets>
      <URL value="@../resources/styles/CatalogoStyles.css" />
   </stylesheets>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label styleClass="titulo" text="QuickMart - Inventario de Ventas" />
      <Label styleClass="etiqueta" text="Todas las ventas registradas en el sistema" />

      <TableView fx:id="tblInventarioVentas" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colIdVenta" text="ID Venta" prefWidth="90.0" />
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="130.0" />
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="90.0" />
            <TableColumn fx:id="colProducto" text="Producto" prefWidth="140.0" />
            <TableColumn fx:id="colCategoria" text="Categoria" prefWidth="100.0" />
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="70.0" />
            <TableColumn fx:id="colPrecioUnitario" text="Precio Unitario" prefWidth="100.0" />
            <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="90.0" />
         </columns>
      </TableView>

      <Label fx:id="lblTotalVentas" styleClass="titulo" text="Total vendido: Q0.00" />

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="btnCerrar" mnemonicParsing="false" onMouseClicked="#onCerrar" styleClass="btn-primary" text="Cerrar" />
         </children>
      </HBox>
   </children>
</VBox>
